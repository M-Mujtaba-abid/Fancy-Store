{
  "version": 2,
  "installCommand": "npm install --omit=dev",
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-seed-reviews",
      "schedule": "0 3 * * *"
    }
  ]
}
